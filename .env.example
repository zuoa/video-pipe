# Copy this file to .env and set the published image.
# docker compose reads VIDEOPIPE_IMAGE automatically. No local build is performed.
#
# Replace <owner> with your GitHub username/org (lowercase). CI publishes to GHCR
# under ghcr.io/<owner>/<repo>. If your repo is named "video-pipe", the image is:
VIDEOPIPE_IMAGE=ghcr.io/owner/video-pipe:latest

# Host (domain or IP) that browsers use to reach MediaMTX's playback ports. The
# UI builds the RTSP/RTMP/HLS/WebRTC/SRT playback URLs from this value, so it
# must be reachable from the client's machine.
#   - "localhost" only works when you open the UI on the same host running the
#     container (e.g. local dev).
#   - For LAN/remote access set this to the server's IP or domain, e.g.
#     192.168.1.10 or video.example.com, and publish the MediaMTX ports in
#     docker-compose.yml (8554/1935/8888/8889/8890 are published by default).
PLAYBACK_HOST=localhost

# Optional: cap uploaded source-file size in bytes (0 = unlimited). Applies to
# the "file" source-type upload in the UI.
# UPLOAD_MAX_BYTES=0

# Optional: which playback protocols to advertise in the UI/API. Uncomment and set
# to 0/false/no to hide one (e.g. ENABLE_WEBRTC=0). To truly disable a protocol
# server-side, also set it to "no" in mediamtx.yml and unpublish its port.
# ENABLE_RTSP=1
# ENABLE_RTMP=1
# ENABLE_HLS=1
# ENABLE_WEBRTC=1
# ENABLE_SRT=1
